# Required
NEXT_PUBLIC_GTM_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_POSTHOG_KEY="phc_XXXXXXXXXX"

# Optional - Tally.so feedback form (leave empty to disable)
NEXT_PUBLIC_TALLY_FORM_ID=""

# Required - Supabase (anonymous auth + rate limiting)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Required - OpenAI-compatible LLM (used for AI post generation)
LLM_API_KEY="sk-..."
# Optional - defaults to gpt-4o-mini
LLM_MODEL=""
# Optional - model for the one-shot onboarding analysis calls (profile
# inference, post insights). Defaults to gpt-5-mini.
LLM_ANALYSIS_MODEL=""

# Optional - LinkedIn publishing & scheduling (Wave 4). Leave blank to keep the
# integration inert. Create an app at https://www.linkedin.com/developers/apps and
# add the "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn" products.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Optional - defaults to <site.url>/api/linkedin/callback. Must exactly match an
# "Authorized redirect URL" registered on the LinkedIn app.
LINKEDIN_REDIRECT_URI=""
# 64-char hex (32 bytes) AES-256-GCM key for encrypting tokens at rest.
# Generate with: openssl rand -hex 32
LINKEDIN_TOKEN_ENC_KEY=""
# Shared secret for the Vercel Cron publisher. Generate with: openssl rand -hex 16
CRON_SECRET=""
# Supabase service-role key (Project Settings > API). Required for the cron publisher
# AND for LinkedIn login (resolving which account owns a LinkedIn identity and
# switching the session into it). Without it, LinkedIn connect falls back to
# attach-only and cannot sign returning users back into their existing account.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional - onboarding profile enrichment (two tiers, both inert when blank).
#
# FAST tier (live Mirror screen, synchronous ~3-8s): Scrapingdog's LinkedIn
# profile API. Get a key at https://www.scrapingdog.com (LinkedIn Profile
# Scraper product). Without it, the fast tier falls back to a direct JSON-LD
# fetch that works locally but is usually blocked from Vercel.
SCRAPINGDOG_API_KEY=""
#
# RICH tier (background insights: posts, followers, topic mix; async 42-60s):
# Bright Data's "LinkedIn People Profile" dataset. Get a key at
# https://brightdata.com (the account must be ACTIVE - add a payment method).
# Dataset id defaults to the LinkedIn People Profile dataset; override only if needed.
BRIGHTDATA_API_KEY=""
BRIGHTDATA_LINKEDIN_DATASET_ID=""

# Optional - generic scraping/residential-proxy API used by the fast profile
# fetch (helps when Vercel IPs are blocked). Called as `${URL}?url=<target>`
# with the optional KEY sent as a Bearer token. See lib/linkedin/public-profile.ts.
LINKEDIN_SCRAPE_API_URL=""
LINKEDIN_SCRAPE_API_KEY=""

# Optional - LinkedIn analytics (Wave 5). A SEPARATE LinkedIn app (App B) for the
# Community Management API, which LinkedIn requires to be the only product on an
# app (so it cannot share App A above). When unset, analytics sync/import stay
# inert and the dashboard relies on manual/CSV entry. App B tokens are encrypted
# at rest with LINKEDIN_TOKEN_ENC_KEY (above).
LINKEDIN_ANALYTICS_CLIENT_ID=""
LINKEDIN_ANALYTICS_CLIENT_SECRET=""
# Optional override - defaults to <site.url>/api/linkedin/analytics/callback.
LINKEDIN_ANALYTICS_REDIRECT_URI=""

# Optional - Stripe billing (onboarding paywall + upgrade). All optional: when
# blank, checkout/webhook stay inert and the offer screen falls back to
# "Continue on the free plan". Fill these in once the Stripe account is set up.
# Use live keys (sk_live/pk_live) for production; the Price IDs must come from
# the same (live) Stripe account.
STRIPE_SECRET_KEY=""
# Webhook signing secret from the Stripe dashboard endpoint (POST /api/billing/webhook).
# Required for purchases to upgrade the user's plan in Supabase.
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs created in the Stripe dashboard for each plan.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_LIFETIME=""
# Client-side publishable key for Stripe.js embedded checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
